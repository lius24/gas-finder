# Copy to .env and fill in.
# Anything prefixed with EXPO_PUBLIC_ is bundled into the client and visible to anyone with the app.
# Do NOT put secrets here. Service-role / private keys belong in Supabase function secrets only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by react-native-maps native config. Replace via EAS secrets for production builds.
GOOGLE_MAPS_API_KEY=your-google-maps-key
